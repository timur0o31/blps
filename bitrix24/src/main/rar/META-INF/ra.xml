                <connectionfactory-interface>org.example.bitrix24.api.OrderConnectionFactory</connectionfactory-interface>
                <connectionfactory-impl-class>org.example.bitrix24.outbound.OrderConnectionFactoryImpl</connectionfactory-impl-class>
                <connection-interface>org.example.bitrix24.api.OrderConnection</connection-interface>
                <connection-impl-class>org.example.bitrix24.outbound.OrderConnectionImpl</connection-impl-class>
            </connection-definition>
            <transaction-support>NoTransaction</transaction-support>
            <reauthentication-support>false</reauthentication-support>
        </outbound-resourceadapter>
    </resourceadapter>
</connector>
