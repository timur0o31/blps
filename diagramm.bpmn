  <bpmn:process id="admin_account_state_process" name="Включение и выключение администратора" isExecutable="true" camunda:candidateStarterGroups="camunda-admin" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_AdminState">
