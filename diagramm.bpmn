      <bpmn:outgoing>Flow_AdminStateChangeEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_AdminState" name="Состояние изменено">
      <bpmn:incoming>Flow_AdminStateChangeEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AdminStateStartLoad" sourceRef="Start_AdminState" targetRef="Task_LoadAdminOptions" />
    <bpmn:sequenceFlow id="Flow_AdminStateLoadSelect" sourceRef="Task_LoadAdminOptions" targetRef="Task_SelectAdminState" />
    <bpmn:sequenceFlow id="Flow_AdminStateSelectChange" sourceRef="Task_SelectAdminState" targetRef="Task_ChangeAdminState" />
    <bpmn:sequenceFlow id="Flow_AdminStateChangeEnd" sourceRef="Task_ChangeAdminState" targetRef="End_AdminState" />
  </bpmn:process>
