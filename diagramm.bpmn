<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OrderLifecycle" targetNamespace="http://example.org/blps" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:message id="Message_OrderCreated" name="order-created" />
  <bpmn:collaboration id="Collaboration_OrderLifecycle">
    <bpmn:participant id="Participant_Create" name="Создание заказа" processRef="create_order_process" />
    <bpmn:participant id="Participant_Lifecycle" name="Обработка заказа курьером" processRef="process_order_assignment" />
    <bpmn:participant id="Participant_CourierShift" name="Изменение статуса смены курьера" processRef="courier_shift_status_process" />
    <bpmn:messageFlow id="MessageFlow_OrderCreated" name="order-created" sourceRef="Task_Publish" targetRef="Start_Assignment" />
  </bpmn:collaboration>
  <bpmn:process id="create_order_process" name="Создание заказа" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_CreateOrder">
      <bpmn:lane id="Lane_Client" name="Клиент">
        <bpmn:flowNodeRef>Start_Create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CreateSystem" name="Система">
        <bpmn:flowNodeRef>Task_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Create</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Create" name="Запрос на создание заказа" camunda:initiator="clientCamundaUserId">
      <bpmn:outgoing>F_Create_Fill</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_FillOrder" name="Оформить заказ" camunda:assignee="${clientCamundaUserId}" camunda:formKey="embedded:deployment:/forms/create-order.html">
      <bpmn:incoming>F_Create_Fill</bpmn:incoming>
      <bpmn:outgoing>F_Create_Save</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Save" name="Сохранить заказ в статусе NEW" camunda:type="external" camunda:topic="save-order">
      <bpmn:incoming>F_Create_Save</bpmn:incoming>
      <bpmn:outgoing>F_Save_Publish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Publish" name="Передать заказ на назначение" camunda:type="external" camunda:topic="publish-order-created">
      <bpmn:incoming>F_Save_Publish</bpmn:incoming>
      <bpmn:outgoing>F_Publish_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Create" name="Заказ передан в обработку">
      <bpmn:incoming>F_Publish_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Create_Fill" sourceRef="Start_Create" targetRef="Task_FillOrder" />
    <bpmn:sequenceFlow id="F_Create_Save" sourceRef="Task_FillOrder" targetRef="Task_Save" />
    <bpmn:sequenceFlow id="F_Save_Publish" sourceRef="Task_Save" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="F_Publish_End" sourceRef="Task_Publish" targetRef="End_Create" />
  </bpmn:process>
  <bpmn:process id="process_order_assignment" name="Обработка заказа" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_OrderLifecycle">
      <bpmn:lane id="Lane_Courier" name="Курьер">
        <bpmn:flowNodeRef>Task_UpdateOrderStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CourierDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_AssignmentTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система">
        <bpmn:flowNodeRef>Task_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Expire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Assignment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RetryTimeoutThrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RetryCatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkCourier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Attempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Waiting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_WaitingTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApplyOrderStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RetryRejectThrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RetryTimerThrow</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Task_Failed" name="Перевести заказ в статус FAILED" camunda:type="external" camunda:topic="mark-order-failed">
      <bpmn:incoming>F_LimitYes</bpmn:incoming>
      <bpmn:outgoing>F_Failed_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Failed" name="Назначение невозможно">
      <bpmn:incoming>F_Failed_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Find" name="Найти доступного курьера" camunda:type="external" camunda:topic="find-available-courier">
      <bpmn:incoming>F_LimitNo</bpmn:incoming>
      <bpmn:outgoing>F_Find_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Found" name="Курьер найден?" default="F_NotFound">
      <bpmn:incoming>F_Find_Gateway</bpmn:incoming>
      <bpmn:outgoing>F_Found</bpmn:outgoing>
      <bpmn:outgoing>F_NotFound</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Expire" name="Освободить просроченное назначение" camunda:type="external" camunda:topic="expire-order-assignment">
      <bpmn:incoming>F_AssignmentTimeout_Expire</bpmn:incoming>
      <bpmn:outgoing>F_Expire_Link</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start_Assignment" name="Получен заказ">
      <bpmn:outgoing>F_Start_Check</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_OrderCreated" messageRef="Message_OrderCreated" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Event_RetryTimeoutThrow" name="Повторить назначение">
      <bpmn:incoming>F_Expire_Link</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_RetryTimeout" name="Повторить назначение" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_CheckLimit" name="Проверить лимит попыток назначения" camunda:type="external" camunda:topic="check-assignment-limit">
      <bpmn:incoming>F_Start_Check</bpmn:incoming>
      <bpmn:incoming>F_Retry_Check</bpmn:incoming>
      <bpmn:outgoing>F_Check_Limit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_RetryCatch" name="Повторить назначение">
      <bpmn:outgoing>F_Retry_Check</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Link_RetryCatch" name="Повторить назначение" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_MarkCourier" name="Перевести курьера в статус ACCEPTING_ORDER" camunda:type="external" camunda:topic="mark-courier-accepting">
      <bpmn:incoming>F_Assign_Mark</bpmn:incoming>
      <bpmn:outgoing>Flow_1nwii46</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Assign" name="Назначить курьера заказу" camunda:type="external" camunda:topic="assign-courier-to-order">
      <bpmn:incoming>F_Attempt_Assign</bpmn:incoming>
      <bpmn:outgoing>F_Assign_Mark</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Attempt" name="Создать попытку назначения" camunda:type="external" camunda:topic="create-assignment-attempt">
      <bpmn:incoming>F_Found</bpmn:incoming>
      <bpmn:outgoing>F_Attempt_Assign</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Waiting" name="Перевести заказ в статус WAITING" camunda:type="external" camunda:topic="mark-order-waiting">
      <bpmn:incoming>F_NotFound</bpmn:incoming>
      <bpmn:outgoing>F_Waiting_Timer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_WaitingTimer" name="Ожидание 30 секунд">
      <bpmn:incoming>F_Waiting_Timer</bpmn:incoming>
      <bpmn:outgoing>F_Timer_Link</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_Waiting">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Limit" name="Лимит исчерпан?" default="F_LimitNo">
      <bpmn:incoming>F_Check_Limit</bpmn:incoming>
      <bpmn:outgoing>F_LimitYes</bpmn:outgoing>
      <bpmn:outgoing>F_LimitNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_LimitYes" name="да" sourceRef="Gateway_Limit" targetRef="Task_Failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${limitReached == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Failed_End" sourceRef="Task_Failed" targetRef="End_Failed" />
    <bpmn:sequenceFlow id="F_LimitNo" name="нет" sourceRef="Gateway_Limit" targetRef="Task_Find" />
    <bpmn:sequenceFlow id="F_Find_Gateway" sourceRef="Task_Find" targetRef="Gateway_Found" />
    <bpmn:sequenceFlow id="F_Found" name="да" sourceRef="Gateway_Found" targetRef="Task_Attempt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${courierFound == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_NotFound" name="нет" sourceRef="Gateway_Found" targetRef="Task_Waiting" />
    <bpmn:sequenceFlow id="F_Decision_Gateway" sourceRef="Task_CourierDecision" targetRef="Gateway_Accepted" />
    <bpmn:sequenceFlow id="F_Expire_Link" sourceRef="Task_Expire" targetRef="Event_RetryTimeoutThrow" />
    <bpmn:sequenceFlow id="F_Start_Check" sourceRef="Start_Assignment" targetRef="Task_CheckLimit" />
    <bpmn:sequenceFlow id="F_Retry_Check" sourceRef="Event_RetryCatch" targetRef="Task_CheckLimit" />
    <bpmn:sequenceFlow id="F_Check_Limit" sourceRef="Task_CheckLimit" targetRef="Gateway_Limit" />
    <bpmn:sequenceFlow id="F_Assign_Mark" sourceRef="Task_Assign" targetRef="Task_MarkCourier" />
    <bpmn:sequenceFlow id="F_Attempt_Assign" sourceRef="Task_Attempt" targetRef="Task_Assign" />
    <bpmn:sequenceFlow id="F_Waiting_Timer" sourceRef="Task_Waiting" targetRef="Event_WaitingTimer" />
    <bpmn:sequenceFlow id="F_Timer_Link" sourceRef="Event_WaitingTimer" targetRef="Event_RetryTimerThrow" />
    <bpmn:exclusiveGateway id="Gateway_Accepted" name="Заказ принят?" default="F_Rejected">
      <bpmn:incoming>F_Decision_Gateway</bpmn:incoming>
      <bpmn:outgoing>F_Rejected</bpmn:outgoing>
      <bpmn:outgoing>F_Accepted</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Reject" name="Зафиксировать отказ курьера" camunda:type="external" camunda:topic="reject-order-assignment">
      <bpmn:incoming>F_Rejected</bpmn:incoming>
      <bpmn:outgoing>F_Reject_Link</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Accept" name="Перевести заказ в статус ACCEPTED" camunda:type="external" camunda:topic="accept-order-assignment">
      <bpmn:incoming>F_Accepted</bpmn:incoming>
      <bpmn:outgoing>F_Accept_Update</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Delivered" name="Заказ доставлен">
      <bpmn:incoming>F_Delivered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Delivered" name="Заказ доставлен?" default="F_NotDelivered">
      <bpmn:incoming>F_Service_Delivered</bpmn:incoming>
      <bpmn:outgoing>F_Delivered</bpmn:outgoing>
      <bpmn:outgoing>F_NotDelivered</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ApplyOrderStatus" name="Перевести заказ в выбранный статус" camunda:type="external" camunda:topic="update-order-delivery-status">
      <bpmn:incoming>F_Update_Service</bpmn:incoming>
      <bpmn:outgoing>F_Service_Delivered</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_RetryRejectThrow" name="Повторить назначение">
      <bpmn:incoming>F_Reject_Link</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_RetryReject" name="Повторить назначение" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Task_UpdateOrderStatus" name="Изменить статус доставки" camunda:assignee="${courierCamundaUserId}" camunda:formKey="embedded:deployment:/forms/update-order-status.html">
      <bpmn:incoming>F_Accept_Update</bpmn:incoming>
      <bpmn:incoming>F_NotDelivered</bpmn:incoming>
      <bpmn:outgoing>F_Update_Service</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_Update_Service" sourceRef="Task_UpdateOrderStatus" targetRef="Task_ApplyOrderStatus" />
    <bpmn:sequenceFlow id="F_Accepted" name="да" sourceRef="Gateway_Accepted" targetRef="Task_Accept">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accepted == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Rejected" name="нет" sourceRef="Gateway_Accepted" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F_Reject_Link" sourceRef="Task_Reject" targetRef="Event_RetryRejectThrow" />
    <bpmn:sequenceFlow id="F_Accept_Update" sourceRef="Task_Accept" targetRef="Task_UpdateOrderStatus" />
    <bpmn:sequenceFlow id="F_Delivered" name="да" sourceRef="Gateway_Delivered" targetRef="End_Delivered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderDelivered == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Service_Delivered" sourceRef="Task_ApplyOrderStatus" targetRef="Gateway_Delivered" />
    <bpmn:sequenceFlow id="F_NotDelivered" name="нет" sourceRef="Gateway_Delivered" targetRef="Task_UpdateOrderStatus" />
    <bpmn:sequenceFlow id="Flow_1nwii46" sourceRef="Task_MarkCourier" targetRef="Task_CourierDecision" />
    <bpmn:sequenceFlow id="F_AssignmentTimeout_Expire" sourceRef="Boundary_AssignmentTimeout" targetRef="Task_Expire" />
    <bpmn:userTask id="Task_CourierDecision" name="Принять или отклонить заказ" camunda:assignee="${courierCamundaUserId}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="accepted" label="Принять заказ" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1nwii46</bpmn:incoming>
      <bpmn:outgoing>F_Decision_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_AssignmentTimeout" name="Ответ не получен за 2 минуты" attachedToRef="Task_CourierDecision">
      <bpmn:outgoing>F_AssignmentTimeout_Expire</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0xkk2gs">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Event_RetryTimerThrow" name="Повторить назначение">
      <bpmn:incoming>F_Timer_Link</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_RetryTimer" name="Повторить назначение" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="courier_shift_status_process" name="Изменение статуса смены курьера" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_CourierShift">
      <bpmn:lane id="Lane_CourierShiftCourier" name="Курьер">
        <bpmn:flowNodeRef>Start_CourierShift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CourierShiftDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CourierShiftSystem" name="Система">
        <bpmn:flowNodeRef>Task_ChangeCourierShift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CourierShift</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_CourierShift" name="Запрос изменения смены" camunda:initiator="courierCamundaUserId">
      <bpmn:outgoing>F_CourierShift_Start_Decision</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CourierShiftDecision" name="Подтвердить изменение смены" camunda:assignee="${courierCamundaUserId}">
      <bpmn:incoming>F_CourierShift_Start_Decision</bpmn:incoming>
      <bpmn:outgoing>F_CourierShift_Decision_Change</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ChangeCourierShift" name="Переключить статус смены курьера" camunda:type="external" camunda:topic="courier-status-toggle">
      <bpmn:incoming>F_CourierShift_Decision_Change</bpmn:incoming>
      <bpmn:outgoing>F_CourierShift_Change_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_CourierShift" name="Статус смены изменён">
      <bpmn:incoming>F_CourierShift_Change_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CourierShift_Start_Decision" sourceRef="Start_CourierShift" targetRef="Task_CourierShiftDecision" />
    <bpmn:sequenceFlow id="F_CourierShift_Decision_Change" sourceRef="Task_CourierShiftDecision" targetRef="Task_ChangeCourierShift" />
    <bpmn:sequenceFlow id="F_CourierShift_Change_End" sourceRef="Task_ChangeCourierShift" targetRef="End_CourierShift" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_OrderLifecycle">
    <bpmndi:BPMNPlane id="Plane_OrderLifecycle" bpmnElement="Collaboration_OrderLifecycle">
      <bpmndi:BPMNShape id="S_P_Create" bpmnElement="Participant_Create" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="900" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_CreateSystem" bpmnElement="Lane_CreateSystem" isHorizontal="true" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="190" y="220" width="870" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_Client" bpmnElement="Lane_Client" isHorizontal="true" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="190" y="80" width="870" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_StartCreate" bpmnElement="Start_Create">
        <dc:Bounds x="240" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="216" y="168" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_FillOrder" bpmnElement="Task_FillOrder">
        <dc:Bounds x="340" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Save" bpmnElement="Task_Save">
        <dc:Bounds x="550" y="250" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Publish" bpmnElement="Task_Publish">
        <dc:Bounds x="730" y="250" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EndCreate" bpmnElement="End_Create">
        <dc:Bounds x="930" y="272" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="906" y="308" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_CF" bpmnElement="F_Create_Fill">
        <di:waypoint x="276" y="150" />
        <di:waypoint x="340" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_CreateSave" bpmnElement="F_Create_Save">
        <di:waypoint x="470" y="150" />
        <di:waypoint x="510" y="150" />
        <di:waypoint x="510" y="290" />
