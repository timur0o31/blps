    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AdminRegistrationStartFill" sourceRef="Start_AdminRegistration" targetRef="Task_FillAdminRegistration" />
    <bpmn:sequenceFlow id="Flow_AdminRegistrationRetry" name="нет" sourceRef="Gateway_AdminRegistrationResult" targetRef="Task_FillAdminRegistration" />
