    <bpmn:sequenceFlow id="Flow_AdminRegistrationRegisterResult" sourceRef="Task_RegisterAdmin" targetRef="Gateway_AdminRegistrationResult" />
    <bpmn:sequenceFlow id="Flow_AdminRegistrationSuccess" name="да" sourceRef="Gateway_AdminRegistrationResult" targetRef="End_AdminRegistration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${registrationSuccessful == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
